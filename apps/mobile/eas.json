{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FASTQUE_CREDITS_ENABLED": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FASTQUE_CREDITS_ENABLED": "false"
      }
    },
    "android-internal-1-0-7": {
      "extends": "production",
      "distribution": "store",
      "environment": "production",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_FASTQUE_CREDITS_ENABLED": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {},
    "android-internal-1-0-7": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
