{
  "expo": {
    "name": "BarberCue",
    "slug": "devdutta-kumar-pandey",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dcw.barbercue",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dcw.barbercue",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1C1A17",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "01998c87-126d-40e8-aac3-205891b74b08"
      }
    },
    "owner": "dcw-team",
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B85C38",
          "defaultChannel": "barbercue-operations"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BarberCue needs access to your photos so you can try the AI Style Advisor."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BarberCue uses your location to show nearby barbershops."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/01998c87-126d-40e8-aac3-205891b74b08",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 2000,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
