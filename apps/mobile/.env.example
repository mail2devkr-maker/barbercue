# Copy to .env for local development. Never commit the real file (already gitignored).
# EXPO_PUBLIC_ vars are inlined at build/bundle time by Expo/Metro.
#
# Note: on an Android emulator, "localhost" refers to the emulator itself, not your host
# machine — use http://10.0.2.2:3000/api/v1 there. On iOS simulator or a browser (expo start
# --web), localhost works directly. On a physical device, use your machine's LAN IP.
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"

# The web app's own origin (a separate Railway service from the backend API) — used to build
# shareable salon links ("Share" on a booking). Not required for the app to function; without it,
# share links fall back to localhost and won't resolve off-device.
EXPO_PUBLIC_WEB_ORIGIN="http://localhost:3001"

# Google Sign-In. The web client ID is public by design (an OAuth client ID, not a secret) and is
# required by the native Credential Manager flow as the ID-token audience. The Google Cloud/Firebase
# project must also contain an Android OAuth client for com.dcw.fastque with the actual EAS release
# signing SHA-1/256. The Expo config plugin in app.json applies google-services.json to native builds.
# If this configuration is missing or invalid, the app keeps the button visible and shows a
# recoverable error instead of silently ignoring the tap. See ARCHITECTURE.md for the manual
# Google Cloud Console steps.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""

# FastQue Credits release gate. Local development must opt in explicitly with "true". Builds pin
# this value in eas.json; EAS Update must use the matching EAS environment value because build
# profile env values are not automatically applied to updates. Unset, malformed, or non-literal
# values disable Credits. See lib/feature-flags.ts.
EXPO_PUBLIC_FASTQUE_CREDITS_ENABLED="true"
