# Copy to .env for local development. Never commit the real .env file (already gitignored).
# See DEPLOYMENT.md for the full environment-configuration model.

# --- Server ---
PORT=3000

# --- Database (Phase 1: required for Prisma) ---
# Local dev example (adjust to your local/managed Postgres instance):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbercue_dev?schema=public"

# --- Auth (used from Phase 2 onward — present now so the shape is settled) ---
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_REFRESH_SECRET="change-me-dev-only"

# --- OTP provider (Phase 2 — customer phone-OTP auth) ---
OTP_PROVIDER_API_KEY=""

# --- Payments (Phase 4 — Razorpay UPI integration, not wired yet) ---
PAYMENT_PROVIDER_KEY_ID=""
PAYMENT_PROVIDER_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# --- Object storage (later phase — salon photos) ---
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_KEY=""

# --- Web ISR revalidation webhook (later phase) ---
REVALIDATE_SECRET="change-me-dev-only"
