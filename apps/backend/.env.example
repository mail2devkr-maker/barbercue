# Copy to .env for local development. Never commit the real .env file (already gitignored).
# See DEPLOYMENT.md for the full environment-configuration model.

# --- Server ---
PORT=3000
NODE_ENV=development
WEB_BASE_URL="http://localhost:3001"

# --- Database (Phase 1: required for Prisma) ---
# Local dev example (adjust to your local/managed Postgres instance):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barbercue_dev?schema=public"

# --- Auth (Phase 2) ---
JWT_ACCESS_SECRET="change-me-dev-only"
# AES key for encrypting User.totpSecret at rest (admin 2FA). Any long random string; rotating
# it invalidates every already-provisioned TOTP secret, so treat it like any other prod secret.
TOTP_ENCRYPTION_KEY="change-me-dev-only"

# --- Admin seed (Phase 2 — apps/backend/prisma/seed.ts; admin accounts are seeded, not self-serve) ---
ADMIN_SEED_EMAIL="admin@barbercue.app"
ADMIN_SEED_PASSWORD="change-me-dev-only"

# --- OTP provider (Phase 2 — customer phone-OTP auth). Not required: the dev ConsoleOtpSender
# logs the code instead of sending a real SMS until this is wired to a real vendor. ---
OTP_PROVIDER_API_KEY=""

# --- Email provider (Phase 2 — forgot-password emails). Not required: the dev
# ConsoleEmailSender logs the reset link instead of emailing it until wired to a real vendor. ---
EMAIL_PROVIDER_API_KEY=""

# --- Payments (Phase 4 — Razorpay UPI integration, not wired yet) ---
PAYMENT_PROVIDER_KEY_ID=""
PAYMENT_PROVIDER_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# --- Object storage (later phase — salon photos) ---
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_KEY=""

# --- Web ISR revalidation webhook (later phase) ---
REVALIDATE_SECRET="change-me-dev-only"
