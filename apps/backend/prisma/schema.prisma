// BarberCue — Prisma schema, Phase 1 foundation.
// Mirrors DATABASE.md model-for-model. Field/model names use Prisma (camelCase) convention and
// map to snake_case tables/columns via @@map/@map, per DATABASE.md's stated convention.
//
// KNOWN ESCAPE HATCH (documented, not a gap): the two partial unique indexes that enforce
// multi-chair/multi-barber concurrency —
//   CREATE UNIQUE INDEX service_session_staff_active_uq ON service_sessions(staff_id) WHERE status = 'ACTIVE';
//   CREATE UNIQUE INDEX service_session_chair_active_uq ON service_sessions(chair_id) WHERE status = 'ACTIVE';
// — cannot be expressed in the Prisma schema DSL (no WHERE-clause unique index support as of the
// current stable Prisma release). They are added directly to the generated SQL migration file
// (see prisma/migrations/) exactly as documented in DATABASE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CUSTOMER
  SALON_STAFF
  SALON_OWNER
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  SIGNUP
}

// Major-upgrade phase: customer auth becomes provider-based. GOOGLE is live; WHATSAPP is reserved
// (see ARCHITECTURE.md) — genuinely free production WhatsApp OTP requires Meta Business
// verification + a paid-per-message account, neither of which exists yet, so no WhatsAppOtpSender
// is wired up. The enum value exists now so a future AuthIdentity row never needs a schema change,
// only a new OtpSender-style implementation.
enum AuthProvider {
  GOOGLE
  WHATSAPP
}

enum SalonStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SalonStaffRole {
  OWNER
  MANAGER
  BARBER
}

enum StaffMemberStatus {
  ACTIVE
  INACTIVE
}

enum ChairStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum PhotoType {
  COVER
  GALLERY
}

enum PrepaymentRequirement {
  NONE
  OPTIONAL
  PARTIAL
  FULL
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum BookingSource {
  APP
  WEB
  WALK_IN
}

enum QueueEntrySource {
  WALK_IN
  APPOINTMENT
}

enum QueueEntryStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum ServiceSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ChargeType {
  FLAT
  PERCENTAGE
}

enum PaymentType {
  BOOKING_PAYMENT
  CANCELLATION_CHARGE
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  INITIATED
  SUCCEEDED
  FAILED
}

enum LedgerReason {
  CANCELLATION_CHARGE
  NO_SHOW_CHARGE
}

enum LedgerStatus {
  OUTSTANDING
  SETTLED
  WAIVED
}

enum SubscriptionStatus {
  PILOT
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
}

enum NotificationChannel {
  SMS
  PUSH
  EMAIL
  // Phase 11 (Notification Center) — the only channel with no external provider to configure;
  // every in-app notification is this channel, always immediately SENT (there is nothing to fail
  // to deliver). SMS/PUSH/EMAIL stay reserved for when a real provider is actually wired
  // (Phase 13's communication-preferences architecture) — this mission does not add one.
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------- Identity & access ----------

model User {
  id               String     @id @default(uuid())
  phone            String?    @unique
  email            String?    @unique
  passwordHash     String?
  phoneVerifiedAt  DateTime?
  emailVerifiedAt  DateTime?
  status           UserStatus @default(ACTIVE)
  twoFactorEnabled Boolean    @default(false)
  totpSecret       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  roles               UserRole[]
  authIdentities      AuthIdentity[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  ownedSalons         Salon[]               @relation("SalonOwner")
  staffMemberships    SalonStaff[]
  bookings            Booking[]             @relation("BookingCustomer")
  cancelledBookings   Booking[]             @relation("BookingCancelledBy")
  queueEntries        QueueEntry[]
  reviews             Review[]
  notifications       Notification[]
  ledgerEntries       CustomerLedgerEntry[]
  auditLogs           AuditLog[]
  premiumSubscriptions CustomerSubscription[]

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role
  salonId   String?
  salon     Salon?   @relation(fields: [salonId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, role, salonId])
  @@map("user_roles")
}

// One row per (provider, external account) a User has linked — additive to, never a replacement
// for, phone/password auth on User itself. A customer can hold a phone-OTP identity AND a Google
// identity on the same User row; sign-in through either lands on the same account.
model AuthIdentity {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  provider    AuthProvider
  // The provider's own stable subject identifier (Google's `sub` claim) — never the email, which
  // can change or be reused. This is the actual identity key for lookups.
  providerSub String
  // Snapshot of the verified email at link time, for display/support only — never used to look up
  // or match an identity; account linking keys off (provider, providerSub) plus a one-time,
  // explicit "does an existing User already have this verified email" check at link time (see
  // AuthService.googleLogin), not off this column on subsequent logins.
  email       String?
  createdAt   DateTime     @default(now())

  @@unique([provider, providerSub])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  // Every login, refresh, revoke, and session-list call looks this table up by tokenHash
  // (TokenService) — the single hottest query in the whole auth system, and until this index it
  // ran as a full table scan. tokenHash is 256 bits of random hex, so a plain (non-unique) index
  // is sufficient — collisions are cryptographically negligible and the code never relies on
  // DB-level uniqueness (rotateRefreshToken's atomic updateMany already guards single-use via
  // revokedAt, not via a unique constraint on this column).
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model OtpRequest {
  id         String     @id @default(uuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
  @@map("otp_requests")
}

// Phase 2 addition — not in the original DATABASE.md field list. Needed to implement the
// approved "Forgot Password" flow for staff/owner/admin (customers never have a password, so
// never use this). Same pattern as RefreshToken/OtpRequest: only a hash of the token is stored,
// never the raw value, so a DB read alone can't be used to reset someone's password.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// ---------- Discovery / SEO ----------

// Global location master data (Phase 1 of the Country -> Region -> City -> Locality
// architecture). Additive only: every field here is nullable and every existing City column/
// constraint below is untouched. Country/Region are not populated yet — that is a separate,
// explicitly-approved future import phase (see import-global-locations.ts, not yet created).
model Country {
  id              String   @id @default(uuid())
  isoCode2        String   @unique
  isoCode3        String?  @unique
  name            String
  nativeName      String?
  phoneCode       String?
  currencyCode    String?
  continent       String?
  subregion       String?
  hasSubdivisions Boolean  @default(false)
  slug            String   @unique
  // Not yet consumed anywhere — a future enrichment candidate for packages/shared's
  // hand-written postalCodeRuleFor, not a replacement for it in this phase.
  postalCodeRegex String?
  // Provenance for imported rows; deliberately NOT unique (see CityAlias/Region below — a
  // source id is only stable within one dataset+version, never a cross-dataset key).
  sourceDataset   String?
  sourceId        Int?
  sourceVersion   String?
  wikiDataId      String?
  regions         Region[]
  cities          City[]
}

// state / province / emirate / oblast / prefecture / territory — one flexible concept, not a
// hierarchy of subtypes. `code` is ISO-3166-2 where the source dataset provides one; never
// invented for a region that doesn't have one.
model Region {
  id            String   @id @default(uuid())
  countryId     String
  country       Country  @relation(fields: [countryId], references: [id])
  code          String?
  name          String
  nativeName    String?
  // The source dataset's own subdivision type label (e.g. "state", "province", "emirate"),
  // stored as-is rather than normalized into an enum BarberCue would have to keep in sync with
  // every country's own administrative vocabulary.
  kind          String?
  slug          String
  sourceDataset String?
  sourceId      Int?
  sourceVersion String?
  wikiDataId    String?
  cities        City[]

  @@unique([countryId, slug])
  @@index([countryId])
}

enum CityAliasKind {
  NATIVE_NAME
  TRANSLITERATION
  HISTORICAL
  COMMON_MISSPELLING
}

// Alternate names for a City (native-script, transliteration, historical, common misspelling)
// so e.g. Mumbai / मुंबई / Bombay can all resolve to the same row without cramming multiple
// names into City.name. Not populated in Phase 1 — see the Phase-1 design report.
model CityAlias {
  id     String        @id @default(uuid())
  cityId String
  city   City          @relation(fields: [cityId], references: [id])
  name   String
  kind   CityAliasKind

  @@index([cityId])
  @@index([name])
}

model City {
  id   String @id @default(uuid())
  name String
  // No longer globally unique: two countries legitimately share a city name (London GB vs
  // London CA, Birmingham GB vs Birmingham US), so uniqueness is scoped by country below.
  slug String
  // ISO-3166-1 alpha-2. The field logic keys on — `country` below stays as free-text display
  // data. Required: a city with no country cannot be validated, priced, or routed.
  countryCode String
  // ISO-3166-2 subdivision where known. Nullable — many countries have no useful subdivision,
  // and inventing one would be fabricated data.
  regionCode  String?
  state       String
  country     String
  localities  Locality[]
  salons      Salon[]

  // ---- Global location master data (Phase 1, additive) ----
  // Nullable and unpopulated until the separate, explicitly-approved global import phase.
  // countryCode/regionCode/state/country above remain the only fields anything reads today.
  countryId     String?
  countryRef    Country? @relation(fields: [countryId], references: [id])
  regionId      String?
  regionRef     Region?  @relation(fields: [regionId], references: [id])
  nativeName    String?
  latitude      Float?
  longitude     Float?
  population    Int?
  sourceDataset String?
  sourceId      Int?
  sourceVersion String?
  wikiDataId    String?
  aliases       CityAlias[]

  @@unique([countryCode, slug])
  @@index([countryCode])
  // Serves the interim CitiesService.findFirst({ slug }) lookup. The composite above cannot:
  // `slug` is not its leading column. Remove once B9's country-scoped routes make every city
  // lookup carry a countryCode.
  @@index([slug])
  // Phase 1 addition, parallel to the constraint above during the deprecation period. Safe with
  // countryId nullable: Postgres does not compare NULLs against each other for uniqueness, so
  // every existing City row (countryId = NULL) is unaffected until backfilled.
  @@unique([countryId, slug])
  @@index([countryId])
  @@index([regionId])
  @@map("cities")
}

model Locality {
  id     String  @id @default(uuid())
  cityId String
  city   City    @relation(fields: [cityId], references: [id])
  name   String
  slug   String
  salons Salon[]

  @@unique([cityId, slug])
  @@map("localities")
}

model Salon {
  id          String      @id @default(uuid())
  // Permanent, human-shareable identifier — "BC-SHOP-000001" — distinct from `id` (the internal
  // UUID primary key, never shown to users). Assigned once at creation by a Postgres sequence (see
  // the add_salon_public_id migration's hand-written SQL default), so uniqueness/monotonicity are
  // guaranteed by the database, not application code — no read-max-then-increment race. Nothing in
  // SalonsService ever writes this column after creation, so it's immutable in practice.
  // dbgenerated() here is a type-only marker (Prisma never emits migration SQL for it) telling
  // Prisma Client the column has a DB-level default — the real default is the raw SQL in the
  // add_salon_public_id migration; this just makes `publicId` optional in create() calls instead
  // of forcing every caller to invent a value.
  publicId    String      @unique @default(dbgenerated("('BC-SHOP-' || lpad(nextval('salon_public_id_seq'::regclass)::text, 6, '0'))"))
  // Phase 9: the shop's permanent QR/public-queue-join identifier — deliberately NOT `publicId`
  // above (that's a sequential, enumerable counter; guessable, unsuitable for a link anyone can
  // join a queue through) and NOT `id` (the internal PK, never exposed publicly). Nullable +
  // lazily generated server-side (PublicQueueTokenService, via Node's crypto.randomBytes — same
  // convention as auth.service.ts's password-reset token) rather than a DB sequence default,
  // since a cryptographically random value isn't a Postgres built-in without the pgcrypto
  // extension. Nullable-unique is safe: Postgres allows multiple NULLs under a unique index (same
  // pattern as CancellationPolicy.salonId).
  publicQueueToken String? @unique
  ownerUserId String
  owner       User        @relation("SalonOwner", fields: [ownerUserId], references: [id])
  name        String
  slug        String
  cityId      String
  city        City        @relation(fields: [cityId], references: [id])
  localityId  String?
  locality    Locality?   @relation(fields: [localityId], references: [id])
  addressLine String
  // IANA timezone (e.g. "Asia/Kolkata", "Europe/London"). Nullable for now: nothing can yet
  // derive a zone at registration — GPS is optional and no lookup service is wired — so
  // requiring it would break registerSalon. AvailabilityService still uses a fixed IST offset
  // and does NOT read this column yet; that switch is a separate, reviewed change.
  timezone    String?
  // ISO-4217 (e.g. "INR", "GBP"). Nullable for the same reason: no source populates it yet.
  // Money columns are already Decimal and currency-agnostic; this records which currency they
  // are denominated in.
  currency    String?
  // Indian 6-digit PIN code. Stored as text, never a number: PIN codes are identifiers, not
  // quantities, and several legitimately need a meaning-bearing shape a numeric type would
  // mangle. Nullable because every salon registered before this column existed has none, and
  // backfilling one would mean inventing an address detail nobody supplied.
  postalCode  String?
  // Nullable since Phase 11: coordinates now come from the device's GPS via the registration
  // form's "Use my current location" button, and an owner who denies that permission (or is on a
  // desktop) must still be able to register. Their only consumer is the schema.org `geo` block on
  // the public salon page — there is no distance search, map, or proximity sort in the product —
  // so a salon without them is fully functional, just slightly less rich to search engines.
  lat         Float?
  lng         Float?
  phone       String?
  // Business contact email, distinct from the owner User's own login email — same "optional
  // business-facing contact field" pattern as `phone` above. Added for shop registration
  // (Phase C); not required, since not every shop has a dedicated reception inbox.
  email       String?
  description String?
  status      SalonStatus @default(PENDING)

  // Subscription fields — inert in V1, see ARCHITECTURE.md §16.
  planId                String?
  plan                  Plan?              @relation(fields: [planId], references: [id])
  subscriptionStatus    SubscriptionStatus @default(PILOT)
  trialEndsAt           DateTime?
  subscriptionExpiresAt DateTime?
  gracePeriodEndsAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles             UserRole[]
  staff                 SalonStaff[]
  chairs                Chair[]
  services              Service[]
  bookings              Booking[]
  queueEntries          QueueEntry[]
  cancellationPolicies  CancellationPolicy[]
  paymentPolicy         SalonPaymentPolicy?
  operatingHours        OperatingHours[]
  photos                Photo[]
  reviews               Review[]
  ledgerEntries         CustomerLedgerEntry[]
  staffChairAssignments StaffChairAssignment[]

  @@unique([cityId, slug])
  @@map("salons")
}

model SalonPaymentPolicy {
  id                    String                @id @default(uuid())
  salonId               String                @unique
  salon                 Salon                 @relation(fields: [salonId], references: [id])
  prepaymentRequirement PrepaymentRequirement @default(NONE)
  prepaymentPercentage  Int?

  @@map("salon_payment_policies")
}

model CancellationPolicy {
  id                             String     @id @default(uuid())
  salonId                        String?    @unique
  salon                          Salon?     @relation(fields: [salonId], references: [id])
  freeCancellationWindowMinutes  Int
  lateCancellationChargeType     ChargeType
  lateCancellationChargeValue    Decimal    @db.Decimal(10, 2)
  noShowChargeType               ChargeType
  noShowChargeValue              Decimal    @db.Decimal(10, 2)
  appointmentArrivalGraceMinutes Int
  queueCallResponseGraceMinutes  Int
  createdAt                      DateTime   @default(now())
  updatedAt                      DateTime   @updatedAt

  @@map("cancellation_policies")
}

model OperatingHours {
  id        String  @id @default(uuid())
  salonId   String
  salon     Salon   @relation(fields: [salonId], references: [id])
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  @@unique([salonId, dayOfWeek])
  @@map("operating_hours")
}

// Phase 7 (barber schedules) — an optional per-barber refinement layer on top of the salon's own
// OperatingHours, not a replacement for it. Deliberately opposite default from OperatingHours: a
// day with NO row here means "unrestricted — this barber works whenever the shop is open," not
// closed, since personal hours are an owner-configured refinement most barbers will never touch.
// Same shape/convention as OperatingHours (dayOfWeek 0=Sunday..6=Saturday, "HH:mm" strings).
model StaffWorkingHours {
  id        String     @id @default(uuid())
  staffId   String
  staff     SalonStaff @relation(fields: [staffId], references: [id])
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean    @default(false)

  @@unique([staffId, dayOfWeek])
  @@map("staff_working_hours")
}

model Photo {
  id        String    @id @default(uuid())
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id])
  url       String
  altText   String?
  type      PhotoType
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@map("photos")
}

// ---------- Staff / chairs (approved concepts, unchanged) ----------

model SalonStaff {
  id          String            @id @default(uuid())
  salonId     String
  salon       Salon             @relation(fields: [salonId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  displayName String
  roleInSalon SalonStaffRole
  status      StaffMemberStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  chairAssignments     StaffChairAssignment[]
  serviceSessions      ServiceSession[]
  services             StaffService[]
  queueEntriesAssigned QueueEntry[]           @relation("AssignedStaff")
  preferredByBookings  Booking[]              @relation("BookingPreferredStaff")
  workingHours         StaffWorkingHours[]

  @@map("salon_staff")
}

model Chair {
  id        String      @id @default(uuid())
  salonId   String
  salon     Salon       @relation(fields: [salonId], references: [id])
  label     String
  status    ChairStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  assignments          StaffChairAssignment[]
  serviceSessions      ServiceSession[]
  queueEntriesAssigned QueueEntry[]           @relation("AssignedChair")

  @@map("chairs")
}

model StaffChairAssignment {
  id            String     @id @default(uuid())
  salonId       String
  salon         Salon      @relation(fields: [salonId], references: [id])
  staffId       String
  staff         SalonStaff @relation(fields: [staffId], references: [id])
  chairId       String
  chair         Chair      @relation(fields: [chairId], references: [id])
  shiftDate     DateTime   @db.Date
  assignedFrom  DateTime
  assignedUntil DateTime?
  createdAt     DateTime   @default(now())

  @@map("staff_chair_assignments")
}

model Service {
  id              String   @id @default(uuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id])
  name            String
  description     String?
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  category        String?
  isActive        Boolean  @default(true)
  // Future-proofing only (DATABASE.md): caps a service below the staff/chair-derived capacity for
  // a service that needs a scarce fixed resource. Unset for every V1 service.
  maxConcurrent   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staffQualifications StaffService[]
  bookings            Booking[]
  queueEntries        QueueEntry[]
  serviceSessions     ServiceSession[]

  @@map("services")
}

model StaffService {
  staffId   String
  staff     SalonStaff @relation(fields: [staffId], references: [id])
  serviceId String
  service   Service    @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId])
  @@map("staff_services")
}

// ---------- Booking & queue ----------

model Booking {
  id                       String        @id @default(uuid())
  salonId                  String
  salon                    Salon         @relation(fields: [salonId], references: [id])
  customerId               String
  customer                 User          @relation("BookingCustomer", fields: [customerId], references: [id])
  serviceId                String
  service                  Service       @relation(fields: [serviceId], references: [id])
  slotStart                DateTime
  slotEnd                  DateTime
  status                   BookingStatus @default(CONFIRMED)
  source                   BookingSource
  idempotencyKey           String        @unique
  // Snapshot of SalonPaymentPolicy x Service.price at creation time — see DATABASE.md.
  prepaymentRequiredAmount Decimal?      @db.Decimal(10, 2)
  // Phase 3B addition: a soft customer preference only, never a capacity constraint — the booking
  // capacity model above stays pool-based (min qualified staff, active chairs), unchanged. Real
  // staff/chair assignment still only happens at queue check-in/dashboard-assign time. Null means
  // "Any Staff". See DATABASE.md's Booking section for the full rationale.
  preferredStaffId         String?
  preferredStaff           SalonStaff?   @relation("BookingPreferredStaff", fields: [preferredStaffId], references: [id])
  // AI Style Advisor phase: the style label the customer picked before booking (e.g. "Textured
  // Crop"), carried through so staff can see it on the dashboard queue view. A free-text snapshot
  // of a small fixed list in packages/shared, not a foreign key — no salon-configurable "style
  // catalog" table exists or is needed for a short, app-wide list of style names.
  selectedStyleName        String?
  cancelledAt              DateTime?
  cancelledById            String?
  cancelledBy              User?         @relation("BookingCancelledBy", fields: [cancelledById], references: [id])
  cancellationChargeAmount Decimal?      @db.Decimal(10, 2)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  // Phase 12 (Appointment Reminders) — set once the reminder sweep has notified this booking's
  // customer, so the periodic sweep never double-reminds. Null means "not sent yet", not "no
  // reminder wanted" — every eligible booking gets exactly one until it's sent.
  reminderSentAt           DateTime?

  queueEntries  QueueEntry[]
  payments      Payment[]
  reviews       Review[]
  ledgerEntries CustomerLedgerEntry[]

  @@index([salonId, slotStart, slotEnd])
  @@map("bookings")
}

model QueueEntry {
  id          String           @id @default(uuid())
  salonId     String
  salon       Salon            @relation(fields: [salonId], references: [id])
  bookingId   String?
  booking     Booking?         @relation(fields: [bookingId], references: [id])
  customerId  String?
  customer    User?            @relation(fields: [customerId], references: [id])
  // Not listed explicitly in DATABASE.md's original field list — added because API.md's walk-in
  // join endpoint accepts an optional serviceId with no other field to hold it before a
  // ServiceSession exists. Documented back into DATABASE.md as a Phase 1 addition, not a
  // contradiction of it. Nullable: an appointment-sourced entry can resolve its service via the
  // linked Booking instead.
  serviceId   String?
  service     Service?         @relation(fields: [serviceId], references: [id])
  source      QueueEntrySource
  tokenNumber Int
  status      QueueEntryStatus @default(WAITING)

  assignedStaffId String?
  assignedStaff   SalonStaff? @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  assignedChairId String?
  assignedChair   Chair?      @relation("AssignedChair", fields: [assignedChairId], references: [id])

  joinedAt             DateTime  @default(now())
  calledAt             DateTime?
  serviceStartedAt     DateTime?
  serviceCompletedAt   DateTime?
  estimatedWaitMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceSessions ServiceSession[]

  @@map("queue_entries")
}

// The concurrency-critical model. See the two partial unique indexes noted at the top of this
// file and enforced in the SQL migration — Prisma schema DSL cannot express them declaratively.
model ServiceSession {
  id           String               @id @default(uuid())
  queueEntryId String
  queueEntry   QueueEntry           @relation(fields: [queueEntryId], references: [id])
  staffId      String
  staff        SalonStaff           @relation(fields: [staffId], references: [id])
  chairId      String
  chair        Chair                @relation(fields: [chairId], references: [id])
  serviceId    String
  service      Service              @relation(fields: [serviceId], references: [id])
  status       ServiceSessionStatus @default(ACTIVE)
  startedAt    DateTime             @default(now())
  endedAt      DateTime?
  createdAt    DateTime             @default(now())

  @@map("service_sessions")
}

// ---------- Payments ----------

model Payment {
  id                String          @id @default(uuid())
  bookingId         String?
  booking           Booking?        @relation(fields: [bookingId], references: [id])
  type              PaymentType
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String?
  providerPaymentId String?         @unique
  idempotencyKey    String          @unique
  status            PaymentStatus   @default(CREATED)
  webhookVerifiedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  refunds           Refund[]
  ledgerSettlements CustomerLedgerEntry[]

  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id])
  amount           Decimal      @db.Decimal(10, 2)
  reason           String?
  providerRefundId String?
  status           RefundStatus @default(INITIATED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("refunds")
}

model CustomerLedgerEntry {
  id                 String       @id @default(uuid())
  customerId         String
  customer           User         @relation(fields: [customerId], references: [id])
  salonId            String
  salon              Salon        @relation(fields: [salonId], references: [id])
  bookingId          String?
  booking            Booking?     @relation(fields: [bookingId], references: [id])
  amount             Decimal      @db.Decimal(10, 2)
  reason             LedgerReason
  status             LedgerStatus @default(OUTSTANDING)
  settledByPaymentId String?
  settledByPayment   Payment?     @relation(fields: [settledByPaymentId], references: [id])
  createdAt          DateTime     @default(now())
  settledAt          DateTime?

  @@map("customer_ledger_entries")
}

// Generic idempotency guard for mutating endpoints (bookings, queue join, payment init,
// cancellation) and deterministic system-triggered transitions (e.g. the no-show sweep job).
model IdempotencyKey {
  key              String   @id
  endpoint         String
  requestHash      String
  responseSnapshot Json?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@map("idempotency_keys")
}

// ---------- Reviews ----------

model Review {
  id            String   @id @default(uuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id])
  customerId    String
  customer      User     @relation(fields: [customerId], references: [id])
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  rating        Int
  comment       String?
  ownerResponse String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("reviews")
}

// ---------- Notifications ----------

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  type      String
  payload   Json?
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  // Phase 11 additions — an IN_APP notification is read/unread (null = unread) rather than the
  // PENDING/SENT/FAILED delivery-attempt lifecycle SMS/PUSH/EMAIL rows use; deepLink is a client
  // route (e.g. "owner/bookings/:id") the notification-center UI navigates to on tap, optional
  // since not every notification type has one obvious destination.
  readAt    DateTime?
  deepLink  String?

  @@map("notifications")
}

// ---------- Audit ----------

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

// ---------- Subscription (inactive in V1 — see ARCHITECTURE.md §16) ----------

model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  priceMonthly Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  salons       Salon[]
  entitlements PlanEntitlement[]

  @@map("plans")
}

model Entitlement {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  plans PlanEntitlement[]

  @@map("entitlements")
}

model PlanEntitlement {
  planId         String
  plan           Plan        @relation(fields: [planId], references: [id])
  entitlementKey String
  entitlement    Entitlement @relation(fields: [entitlementKey], references: [key])
  value          String

  @@id([planId, entitlementKey])
  @@map("plan_entitlements")
}

// ---------- Customer Premium plans & AI credits (Premium phase) ----------
// Deliberately NOT the same concept as Plan/Entitlement/PlanEntitlement above, which is salon
// (B2B) subscription billing — inert in V1, unrelated to this. This is a customer-facing (B2C)
// annual plan that grants AI Style Advisor credits. Kept as fully separate models rather than
// extended/renamed from the salon Plan table to avoid conflating two different billing contexts
// (a salon's platform tier vs. a customer's AI-credit allowance) under one schema concept.

enum CustomerSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// Every balance-affecting event on a CustomerSubscription's AI credits, for auditability (never
// contains customer photos, image bytes, or API keys — see AiCreditService).
enum AiCreditTransactionType {
  ALLOCATION
  RESERVATION
  CONSUMPTION
  RELEASE
  MANUAL_ADJUSTMENT
}

// `id` is a stable, human-readable string ("basic" | "pro" | "max"), not a uuid — same convention
// as packages/shared's HAIRSTYLE_CATALOG: a small, fixed, code-referenced catalog, not open-ended
// data. Single authoritative source for price/credits — PremiumPlansService reads this table
// rather than any value being hard-coded elsewhere.
model CustomerPremiumPlan {
  id               String   @id
  name             String
  priceInr         Decimal  @db.Decimal(10, 2)
  aiCreditsPerYear Int
  isPopular        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  subscriptions CustomerSubscription[]

  @@map("customer_premium_plans")
}

// One row per purchased/activated annual period. Credits are scoped to the period they were
// granted in (aiCreditsAllocated is a snapshot taken at activation, immune to later plan-price/
// credit edits) — deliberately no rollover/carry-forward logic into a future period, per the
// explicit "keep this simple and auditable" instruction for this phase.
model CustomerSubscription {
  id          String                     @id @default(uuid())
  userId      String
  user        User                       @relation(fields: [userId], references: [id])
  planId      String
  plan        CustomerPremiumPlan        @relation(fields: [planId], references: [id])
  status      CustomerSubscriptionStatus @default(ACTIVE)
  periodStart DateTime                   @default(now())
  periodEnd   DateTime

  aiCreditsAllocated Int
  // Reserved = credits held for an in-flight generation request (not yet succeeded or failed).
  // Consumed = permanently spent on a successful generation. Available = allocated - reserved -
  // consumed; see AiCreditService.hasAvailableCredit. Both are maintained by AiCreditService only,
  // inside a per-subscription-locked transaction (see bookings.service.ts's advisory-lock
  // pattern) — never written to directly by any controller.
  aiCreditsReserved Int @default(0)
  aiCreditsConsumed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditTransactions AiCreditTransaction[]

  @@index([userId, status])
  @@map("customer_subscriptions")
}

model AiCreditTransaction {
  id             String                  @id @default(uuid())
  subscriptionId String
  subscription   CustomerSubscription    @relation(fields: [subscriptionId], references: [id])
  type           AiCreditTransactionType
  amount         Int
  note           String?
  createdAt      DateTime                @default(now())

  @@index([subscriptionId, createdAt])
  @@map("ai_credit_transactions")
}
