// BarberCue — Prisma schema, Phase 1 foundation.
// Mirrors DATABASE.md model-for-model. Field/model names use Prisma (camelCase) convention and
// map to snake_case tables/columns via @@map/@map, per DATABASE.md's stated convention.
//
// KNOWN ESCAPE HATCH (documented, not a gap): the two partial unique indexes that enforce
// multi-chair/multi-barber concurrency —
//   CREATE UNIQUE INDEX service_session_staff_active_uq ON service_sessions(staff_id) WHERE status = 'ACTIVE';
//   CREATE UNIQUE INDEX service_session_chair_active_uq ON service_sessions(chair_id) WHERE status = 'ACTIVE';
// — cannot be expressed in the Prisma schema DSL (no WHERE-clause unique index support as of the
// current stable Prisma release). They are added directly to the generated SQL migration file
// (see prisma/migrations/) exactly as documented in DATABASE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CUSTOMER
  SALON_STAFF
  SALON_OWNER
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// Phase 14 (Localization & Voice Operations). Deliberately tiny — see packages/shared/src/i18n's
// own doc comment: a language only belongs here once real translated voice-announcement strings
// exist for it.
enum Language {
  EN
  HI
}

enum OtpPurpose {
  LOGIN
  SIGNUP
}

// Major-upgrade phase: customer auth becomes provider-based. GOOGLE is live; WHATSAPP is reserved
// (see ARCHITECTURE.md) — genuinely free production WhatsApp OTP requires Meta Business
// verification + a paid-per-message account, neither of which exists yet, so no WhatsAppOtpSender
// is wired up. The enum value exists now so a future AuthIdentity row never needs a schema change,
// only a new OtpSender-style implementation.
enum AuthProvider {
  GOOGLE
  WHATSAPP
}

enum SalonStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SalonStaffRole {
  OWNER
  MANAGER
  BARBER
}

enum StaffMemberStatus {
  ACTIVE
  INACTIVE
}

enum ChairStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum PhotoType {
  COVER
  GALLERY
}

enum PrepaymentRequirement {
  NONE
  OPTIONAL
  PARTIAL
  FULL
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum BookingSource {
  APP
  WEB
  WALK_IN
}

enum QueueEntrySource {
  WALK_IN
  APPOINTMENT
}

enum QueueEntryStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELLED
  // Added for the WAITING-day-rollover sweep (see QueueEntryExpiryService.markStaleWaitingExpired):
  // a WAITING entry never called/assigned/cancelled by the end of its salon-local join day. Distinct
  // from NO_SHOW, which only applies after a customer was actually CALLED and didn't respond.
  EXPIRED
}

enum ServiceSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ChargeType {
  FLAT
  PERCENTAGE
}

enum PaymentType {
  BOOKING_PAYMENT
  CANCELLATION_CHARGE
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  INITIATED
  SUCCEEDED
  FAILED
}

enum LedgerReason {
  CANCELLATION_CHARGE
  NO_SHOW_CHARGE
}

enum LedgerStatus {
  OUTSTANDING
  SETTLED
  WAIVED
}

enum SubscriptionStatus {
  PILOT
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
}

enum NotificationChannel {
  SMS
  PUSH
  EMAIL
  // Phase 11 (Notification Center) — the only channel with no external provider to configure;
  // every in-app notification is this channel, always immediately SENT (there is nothing to fail
  // to deliver). SMS/PUSH/EMAIL stay reserved for when a real provider is actually wired
  // (Phase 13's communication-preferences architecture) — this mission does not add one.
  IN_APP
  // Phase 13 — architecture-only, same as SMS/PUSH/EMAIL: manual/deep-link WhatsApp sharing
  // already exists (Phase 3's share flow), but proactive WhatsApp Business API delivery is
  // explicitly out of scope for this mission (no provider configured).
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// Phase 13 (Communication Preferences) — every NotificationType (packages/shared) maps to exactly
// one of these; see NotificationsService's TYPE_CATEGORY. OPERATIONAL categories default enabled
// (a customer expects to hear about their own bookings); PROMOTIONAL defaults enabled too today
// only because nothing currently produces that category — Phase 20+'s offers work should default
// it to opt-in rather than assuming this default carries over.
enum NotificationCategory {
  BOOKING_UPDATES
  QUEUE_UPDATES
  REMINDERS
  PROMOTIONAL
}

// One row per (user, category, channel) the user has explicitly changed from its default. No row
// = default (enabled), same "absence means default" convention as StaffWorkingHours (Phase 7).
model NotificationPreference {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime             @updatedAt

  @@unique([userId, category, channel])
  @@map("notification_preferences")
}

// ---------- Identity & access ----------

model User {
  id                String     @id @default(uuid())
  phone             String?    @unique
  email             String?    @unique
  passwordHash      String?
  phoneVerifiedAt   DateTime?
  emailVerifiedAt   DateTime?
  status            UserStatus @default(ACTIVE)
  twoFactorEnabled  Boolean    @default(false)
  totpSecret        String?
  // Phase 14 (Localization & Voice Operations) — drives which packages/shared/src/i18n
  // VoiceAnnouncements dictionary realtime alert handlers speak from, plus the language switcher's
  // initial state. Defaults to EN, so every existing/new user behaves exactly as before this field
  // existed until they explicitly change it.
  preferredLanguage Language   @default(EN)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  roles                   UserRole[]
  authIdentities          AuthIdentity[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  ownedSalons             Salon[]                  @relation("SalonOwner")
  staffMemberships        SalonStaff[]
  bookings                Booking[]                @relation("BookingCustomer")
  cancelledBookings       Booking[]                @relation("BookingCancelledBy")
  queueEntries            QueueEntry[]
  reviews                 Review[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  ledgerEntries           CustomerLedgerEntry[]
  auditLogs               AuditLog[]
  premiumSubscriptions    CustomerSubscription[]
  // Phase 18 (Shop / Barber Verification Foundation) — an owner submitting evidence, and a
  // PLATFORM_ADMIN reviewing it, are deliberately separate relations (never the same person in
  // practice, and keeping them distinct makes that impossible to blur by accident).
  submittedVerifications  VerificationRequest[]    @relation("VerificationSubmitter")
  reviewedVerifications   VerificationRequest[]    @relation("VerificationReviewer")
  pushDevices             PushDevice[]
  creditAccount           CustomerCreditAccount?

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role
  salonId   String?
  salon     Salon?   @relation(fields: [salonId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, role, salonId])
  @@map("user_roles")
}

// One row per (provider, external account) a User has linked — additive to, never a replacement
// for, phone/password auth on User itself. A customer can hold a phone-OTP identity AND a Google
// identity on the same User row; sign-in through either lands on the same account.
model AuthIdentity {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  provider    AuthProvider
  // The provider's own stable subject identifier (Google's `sub` claim) — never the email, which
  // can change or be reused. This is the actual identity key for lookups.
  providerSub String
  // Snapshot of the verified email at link time, for display/support only — never used to look up
  // or match an identity; account linking keys off (provider, providerSub) plus a one-time,
  // explicit "does an existing User already have this verified email" check at link time (see
  // AuthService.googleLogin), not off this column on subsequent logins.
  email       String?
  createdAt   DateTime     @default(now())

  @@unique([provider, providerSub])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  // Every login, refresh, revoke, and session-list call looks this table up by tokenHash
  // (TokenService) — the single hottest query in the whole auth system, and until this index it
  // ran as a full table scan. tokenHash is 256 bits of random hex, so a plain (non-unique) index
  // is sufficient — collisions are cryptographically negligible and the code never relies on
  // DB-level uniqueness (rotateRefreshToken's atomic updateMany already guards single-use via
  // revokedAt, not via a unique constraint on this column).
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model OtpRequest {
  id         String     @id @default(uuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
  @@map("otp_requests")
}

// Phase 2 addition — not in the original DATABASE.md field list. Needed to implement the
// approved "Forgot Password" flow for staff/owner/admin (customers never have a password, so
// never use this). Same pattern as RefreshToken/OtpRequest: only a hash of the token is stored,
// never the raw value, so a DB read alone can't be used to reset someone's password.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// ---------- Discovery / SEO ----------

// Global location master data (Phase 1 of the Country -> Region -> City -> Locality
// architecture). Additive only: every field here is nullable and every existing City column/
// constraint below is untouched. Country/Region are not populated yet — that is a separate,
// explicitly-approved future import phase (see import-global-locations.ts, not yet created).
model Country {
  id              String   @id @default(uuid())
  isoCode2        String   @unique
  isoCode3        String?  @unique
  name            String
  nativeName      String?
  phoneCode       String?
  currencyCode    String?
  continent       String?
  subregion       String?
  hasSubdivisions Boolean  @default(false)
  slug            String   @unique
  // Not yet consumed anywhere — a future enrichment candidate for packages/shared's
  // hand-written postalCodeRuleFor, not a replacement for it in this phase.
  postalCodeRegex String?
  // Provenance for imported rows; deliberately NOT unique (see CityAlias/Region below — a
  // source id is only stable within one dataset+version, never a cross-dataset key).
  sourceDataset   String?
  sourceId        Int?
  sourceVersion   String?
  wikiDataId      String?
  regions         Region[]
  cities          City[]
}

// state / province / emirate / oblast / prefecture / territory — one flexible concept, not a
// hierarchy of subtypes. `code` is ISO-3166-2 where the source dataset provides one; never
// invented for a region that doesn't have one.
model Region {
  id            String  @id @default(uuid())
  countryId     String
  country       Country @relation(fields: [countryId], references: [id])
  code          String?
  name          String
  nativeName    String?
  // The source dataset's own subdivision type label (e.g. "state", "province", "emirate"),
  // stored as-is rather than normalized into an enum BarberCue would have to keep in sync with
  // every country's own administrative vocabulary.
  kind          String?
  slug          String
  sourceDataset String?
  sourceId      Int?
  sourceVersion String?
  wikiDataId    String?
  cities        City[]

  @@unique([countryId, slug])
  @@index([countryId])
}

enum CityAliasKind {
  NATIVE_NAME
  TRANSLITERATION
  HISTORICAL
  COMMON_MISSPELLING
}

// Alternate names for a City (native-script, transliteration, historical, common misspelling)
// so e.g. Mumbai / मुंबई / Bombay can all resolve to the same row without cramming multiple
// names into City.name. Not populated in Phase 1 — see the Phase-1 design report.
model CityAlias {
  id     String        @id @default(uuid())
  cityId String
  city   City          @relation(fields: [cityId], references: [id])
  name   String
  kind   CityAliasKind

  @@index([cityId])
  @@index([name])
}

model City {
  id          String     @id @default(uuid())
  name        String
  // No longer globally unique: two countries legitimately share a city name (London GB vs
  // London CA, Birmingham GB vs Birmingham US), so uniqueness is scoped by country below.
  slug        String
  // ISO-3166-1 alpha-2. The field logic keys on — `country` below stays as free-text display
  // data. Required: a city with no country cannot be validated, priced, or routed.
  countryCode String
  // ISO-3166-2 subdivision where known. Nullable — many countries have no useful subdivision,
  // and inventing one would be fabricated data.
  regionCode  String?
  state       String
  country     String
  localities  Locality[]
  salons      Salon[]

  // ---- Global location master data (Phase 1, additive) ----
  // Nullable and unpopulated until the separate, explicitly-approved global import phase.
  // countryCode/regionCode/state/country above remain the only fields anything reads today.
  countryId     String?
  countryRef    Country?    @relation(fields: [countryId], references: [id])
  regionId      String?
  regionRef     Region?     @relation(fields: [regionId], references: [id])
  nativeName    String?
  latitude      Float?
  longitude     Float?
  // IANA timezone (e.g. "America/Chicago"), sourced from the same dr5hn import as
  // latitude/longitude above (Part 4, auto timezone selection). Nullable: only populated for
  // cities the global-location importer has enriched — legacy/demo cities and any city imported
  // before this column existed have none until a separate, explicitly-approved backfill runs.
  // This is city-level metadata, never a per-salon override — Salon.timezone remains the
  // authoritative, owner-configurable value; this only feeds the auto-detection suggestion.
  timezone      String?
  population    Int?
  sourceDataset String?
  sourceId      Int?
  sourceVersion String?
  wikiDataId    String?
  aliases       CityAlias[]

  @@unique([countryCode, slug])
  // Phase 1 addition, parallel to the constraint above during the deprecation period. Safe with
  // countryId nullable: Postgres does not compare NULLs against each other for uniqueness, so
  // every existing City row (countryId = NULL) is unaffected until backfilled.
  @@unique([countryId, slug])
  @@index([countryCode])
  // Serves the interim CitiesService.findFirst({ slug }) lookup. The composite above cannot:
  // `slug` is not its leading column. Remove once B9's country-scoped routes make every city
  // lookup carry a countryCode.
  @@index([slug])
  @@index([countryId])
  @@index([regionId])
  @@map("cities")
}

model Locality {
  id     String  @id @default(uuid())
  cityId String
  city   City    @relation(fields: [cityId], references: [id])
  name   String
  slug   String
  salons Salon[]

  @@unique([cityId, slug])
  @@map("localities")
}

model Salon {
  id               String      @id @default(uuid())
  // Permanent, human-shareable identifier — "BC-SHOP-000001" — distinct from `id` (the internal
  // UUID primary key, never shown to users). Assigned once at creation by a Postgres sequence (see
  // the add_salon_public_id migration's hand-written SQL default), so uniqueness/monotonicity are
  // guaranteed by the database, not application code — no read-max-then-increment race. Nothing in
  // SalonsService ever writes this column after creation, so it's immutable in practice.
  // dbgenerated() here is a type-only marker (Prisma never emits migration SQL for it) telling
  // Prisma Client the column has a DB-level default — the real default is the raw SQL in the
  // add_salon_public_id migration; this just makes `publicId` optional in create() calls instead
  // of forcing every caller to invent a value.
  publicId         String      @unique @default(dbgenerated("('BC-SHOP-' || lpad(nextval('salon_public_id_seq'::regclass)::text, 6, '0'))"))
  // Phase 9: the shop's permanent QR/public-queue-join identifier — deliberately NOT `publicId`
  // above (that's a sequential, enumerable counter; guessable, unsuitable for a link anyone can
  // join a queue through) and NOT `id` (the internal PK, never exposed publicly). Nullable +
  // lazily generated server-side (PublicQueueTokenService, via Node's crypto.randomBytes — same
  // convention as auth.service.ts's password-reset token) rather than a DB sequence default,
  // since a cryptographically random value isn't a Postgres built-in without the pgcrypto
  // extension. Nullable-unique is safe: Postgres allows multiple NULLs under a unique index (same
  // pattern as CancellationPolicy.salonId).
  publicQueueToken String?     @unique
  ownerUserId      String
  owner            User        @relation("SalonOwner", fields: [ownerUserId], references: [id])
  name             String
  slug             String
  cityId           String
  city             City        @relation(fields: [cityId], references: [id])
  localityId       String?
  locality         Locality?   @relation(fields: [localityId], references: [id])
  addressLine      String
  // IANA timezone (e.g. "Asia/Kolkata", "Europe/London"). Nullable for now: nothing can yet
  // derive a zone at registration — GPS is optional and no lookup service is wired — so
  // requiring it would break registerSalon. AvailabilityService still uses a fixed IST offset
  // and does NOT read this column yet; that switch is a separate, reviewed change.
  timezone         String?
  // Part 4 (auto timezone selection) provenance flags — never used to gate behavior on their own,
  // only to decide whether a future auto-detect pass may safely replace the current value.
  // `timezoneAutoDetected`: true iff the current `timezone` value was set by resolveAutoTimezone
  // (coordinates/city/country), never by an explicit owner/admin PATCH.
  // `timezoneManuallyOverridden`: true once an owner/admin has ever explicitly PATCHed timezone —
  // once set, auto-detection must never silently overwrite the stored value again.
  timezoneAutoDetected       Boolean @default(false)
  timezoneManuallyOverridden Boolean @default(false)
  // ISO-4217 (e.g. "INR", "GBP"). Nullable for the same reason: no source populates it yet.
  // Money columns are already Decimal and currency-agnostic; this records which currency they
  // are denominated in.
  currency         String?
  // Indian 6-digit PIN code. Stored as text, never a number: PIN codes are identifiers, not
  // quantities, and several legitimately need a meaning-bearing shape a numeric type would
  // mangle. Nullable because every salon registered before this column existed has none, and
  // backfilling one would mean inventing an address detail nobody supplied.
  postalCode       String?
  // Nullable since Phase 11: coordinates now come from the device's GPS via the registration
  // form's "Use my current location" button, and an owner who denies that permission (or is on a
  // desktop) must still be able to register. Their only consumer is the schema.org `geo` block on
  // the public salon page — there is no distance search, map, or proximity sort in the product —
  // so a salon without them is fully functional, just slightly less rich to search engines.
  lat              Float?
  lng              Float?
  phone            String?
  // Business contact email, distinct from the owner User's own login email — same "optional
  // business-facing contact field" pattern as `phone` above. Added for shop registration
  // (Phase C); not required, since not every shop has a dedicated reception inbox.
  email            String?
  description      String?
  status           SalonStatus @default(PENDING)

  // Subscription fields — inert in V1, see ARCHITECTURE.md §16.
  planId                String?
  plan                  Plan?              @relation(fields: [planId], references: [id])
  subscriptionStatus    SubscriptionStatus @default(PILOT)
  trialEndsAt           DateTime?
  subscriptionExpiresAt DateTime?
  gracePeriodEndsAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles             UserRole[]
  staff                 SalonStaff[]
  chairs                Chair[]
  services              Service[]
  bookings              Booking[]
  queueEntries          QueueEntry[]
  cancellationPolicies  CancellationPolicy[]
  paymentPolicy         SalonPaymentPolicy?
  operatingHours        OperatingHours[]
  photos                Photo[]
  reviews               Review[]
  ledgerEntries         CustomerLedgerEntry[]
  staffChairAssignments StaffChairAssignment[]
  // Phase 18 — at most one row (VerificationRequest.salonId is @@unique; NULL salonId rows, i.e.
  // PROFESSIONAL-type requests, are unaffected by that constraint under Postgres NULLS DISTINCT).
  verification          VerificationRequest?
  subsidyEntries        PlatformShopSubsidyEntry[]

  @@unique([cityId, slug])
  @@map("salons")
}

model SalonPaymentPolicy {
  id                    String                @id @default(uuid())
  salonId               String                @unique
  salon                 Salon                 @relation(fields: [salonId], references: [id])
  prepaymentRequirement PrepaymentRequirement @default(NONE)
  prepaymentPercentage  Int?
  // FastQue Credits / Wallet V1 — the shop's own UPI/payment QR image, shown to a customer paying
  // directly for an ONLINE (APP/WEB-sourced) booking. There is no live payment gateway yet (see
  // Payment/Refund above: schema-only, unimplemented — PAYMENTS.md's Razorpay design is not coded),
  // so online payment collection is manual QR-scan-and-pay, and BookingsService.create refuses to
  // create an ONLINE booking (source APP or WEB) at any salon that hasn't configured one
  // (BookingErrorCode.PAYMENT_QR_REQUIRED) — a real backend guard, not just a UI hint. WALK_IN
  // bookings are unaffected. Same "URL-based, no object storage configured" convention as
  // Photo.url, with the same link-or-upload dual path as SalonPhotosService — one column, two ways
  // to fill it.
  paymentQrImageUrl     String?

  @@map("salon_payment_policies")
}

model CancellationPolicy {
  id                             String     @id @default(uuid())
  salonId                        String?    @unique
  salon                          Salon?     @relation(fields: [salonId], references: [id])
  freeCancellationWindowMinutes  Int
  lateCancellationChargeType     ChargeType
  lateCancellationChargeValue    Decimal    @db.Decimal(10, 2)
  noShowChargeType               ChargeType
  noShowChargeValue              Decimal    @db.Decimal(10, 2)
  appointmentArrivalGraceMinutes Int
  queueCallResponseGraceMinutes  Int
  createdAt                      DateTime   @default(now())
  updatedAt                      DateTime   @updatedAt

  @@map("cancellation_policies")
}

model OperatingHours {
  id        String  @id @default(uuid())
  salonId   String
  salon     Salon   @relation(fields: [salonId], references: [id])
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  @@unique([salonId, dayOfWeek])
  @@map("operating_hours")
}

// Phase 7 (barber schedules) — an optional per-barber refinement layer on top of the salon's own
// OperatingHours, not a replacement for it. Deliberately opposite default from OperatingHours: a
// day with NO row here means "unrestricted — this barber works whenever the shop is open," not
// closed, since personal hours are an owner-configured refinement most barbers will never touch.
// Same shape/convention as OperatingHours (dayOfWeek 0=Sunday..6=Saturday, "HH:mm" strings).
model StaffWorkingHours {
  id        String     @id @default(uuid())
  staffId   String
  staff     SalonStaff @relation(fields: [staffId], references: [id])
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean    @default(false)

  @@unique([staffId, dayOfWeek])
  @@map("staff_working_hours")
}

model Photo {
  id        String    @id @default(uuid())
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id])
  url       String
  altText   String?
  type      PhotoType
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@map("photos")
}

// ---------- Staff / chairs (approved concepts, unchanged) ----------

model SalonStaff {
  id              String            @id @default(uuid())
  salonId         String
  salon           Salon             @relation(fields: [salonId], references: [id])
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  displayName     String
  roleInSalon     SalonStaffRole
  status          StaffMemberStatus @default(ACTIVE)
  // Phase 17 (Barber Professional Profile) — all optional/additive. Which services this barber is
  // actually qualified for already lives in StaffService, a real DB-backed relation; these are the
  // genuinely new fields (no existing model covered them). photoUrl follows the same "URL-based,
  // no object storage configured" convention as Salon photos — an owner/staff links an
  // already-hosted image rather than uploading a file.
  bio             String?
  photoUrl        String?
  yearsExperience Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  chairAssignments     StaffChairAssignment[]
  serviceSessions      ServiceSession[]
  services             StaffService[]
  queueEntriesAssigned QueueEntry[]           @relation("AssignedStaff")
  preferredByBookings  Booking[]              @relation("BookingPreferredStaff")
  workingHours         StaffWorkingHours[]
  // Phase 18 — at most one row (VerificationRequest.staffId is @@unique).
  verification         VerificationRequest?

  @@map("salon_staff")
}

model Chair {
  id        String      @id @default(uuid())
  salonId   String
  salon     Salon       @relation(fields: [salonId], references: [id])
  label     String
  status    ChairStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  assignments          StaffChairAssignment[]
  serviceSessions      ServiceSession[]
  queueEntriesAssigned QueueEntry[]           @relation("AssignedChair")

  @@map("chairs")
}

model StaffChairAssignment {
  id            String     @id @default(uuid())
  salonId       String
  salon         Salon      @relation(fields: [salonId], references: [id])
  staffId       String
  staff         SalonStaff @relation(fields: [staffId], references: [id])
  chairId       String
  chair         Chair      @relation(fields: [chairId], references: [id])
  shiftDate     DateTime   @db.Date
  assignedFrom  DateTime
  assignedUntil DateTime?
  createdAt     DateTime   @default(now())

  @@map("staff_chair_assignments")
}

model Service {
  id              String   @id @default(uuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id])
  name            String
  description     String?
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  category        String?
  isActive        Boolean  @default(true)
  // Future-proofing only (DATABASE.md): caps a service below the staff/chair-derived capacity for
  // a service that needs a scarce fixed resource. Unset for every V1 service.
  maxConcurrent   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staffQualifications StaffService[]
  bookings            Booking[]
  queueEntries        QueueEntry[]
  serviceSessions     ServiceSession[]

  @@map("services")
}

model StaffService {
  staffId   String
  staff     SalonStaff @relation(fields: [staffId], references: [id])
  serviceId String
  service   Service    @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId])
  @@map("staff_services")
}

// ---------- Booking & queue ----------

model Booking {
  id                       String        @id @default(uuid())
  salonId                  String
  salon                    Salon         @relation(fields: [salonId], references: [id])
  customerId               String
  customer                 User          @relation("BookingCustomer", fields: [customerId], references: [id])
  serviceId                String
  service                  Service       @relation(fields: [serviceId], references: [id])
  slotStart                DateTime
  slotEnd                  DateTime
  status                   BookingStatus @default(CONFIRMED)
  source                   BookingSource
  idempotencyKey           String        @unique
  // Snapshot of SalonPaymentPolicy x Service.price at creation time — see DATABASE.md.
  prepaymentRequiredAmount Decimal?      @db.Decimal(10, 2)
  // Phase 3B addition: a soft customer preference only, never a capacity constraint — the booking
  // capacity model above stays pool-based (min qualified staff, active chairs), unchanged. Real
  // staff/chair assignment still only happens at queue check-in/dashboard-assign time. Null means
  // "Any Staff". See DATABASE.md's Booking section for the full rationale.
  preferredStaffId         String?
  preferredStaff           SalonStaff?   @relation("BookingPreferredStaff", fields: [preferredStaffId], references: [id])
  // AI Style Advisor phase: the style label the customer picked before booking (e.g. "Textured
  // Crop"), carried through so staff can see it on the dashboard queue view. A free-text snapshot
  // of a small fixed list in packages/shared, not a foreign key — no salon-configurable "style
  // catalog" table exists or is needed for a short, app-wide list of style names.
  selectedStyleName        String?
  cancelledAt              DateTime?
  cancelledById            String?
  cancelledBy              User?         @relation("BookingCancelledBy", fields: [cancelledById], references: [id])
  cancellationChargeAmount Decimal?      @db.Decimal(10, 2)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  // Phase 12 (Appointment Reminders) — set once the reminder sweep has notified this booking's
  // customer, so the periodic sweep never double-reminds. Null means "not sent yet", not "no
  // reminder wanted" — every eligible booking gets exactly one until it's sent.
  reminderSentAt           DateTime?
  // FastQue Credits / Wallet V1 — a snapshot, not a live-recomputed value, so a later change to
  // CREDIT_SLAB_AMOUNT_INR or the wallet balance can never retroactively change what a past
  // booking shows it redeemed. Set once, at creation, to the ACTUAL amount applied after the
  // server clamped the customer's request to min(requested, live balance, the price-based
  // redemption cap) — never the raw client-requested amount. Null means "redeemed nothing", not
  // "unknown". There is deliberately no "credits earned" snapshot: completing a service does not
  // automatically grant credits in this product (see CreditTransactionType.PROMO_GRANT) — credits
  // only ever enter a wallet through an authorized promotional grant or a redemption restoration.
  creditsRedeemedAmount    Decimal?      @db.Decimal(10, 2)
  // Part 5 completion (arrival guidance) — same snapshot rationale as prepaymentRequiredAmount/
  // cancellationChargeAmount/creditsRedeemedAmount above: captured once, at creation time, from
  // whatever rule was actually in effect then, so a later change to the salon's
  // CancellationPolicy.appointmentArrivalGraceMinutes (or, in principle, the platform-wide
  // EARLY_CHECKIN_WINDOW_MINUTES constant) can never retroactively change what a past booking's
  // "please arrive by" / "check in from" guidance displays. Null on any booking created before
  // this column existed — such a booking shows no arrival guidance at all rather than guessing
  // from the CURRENT policy, which could be wrong for what the customer was actually told.
  checkInOpensMinutesBefore Int?
  checkInDueGraceMinutes    Int?

  queueEntries       QueueEntry[]
  payments           Payment[]
  reviews            Review[]
  ledgerEntries      CustomerLedgerEntry[]
  creditTransactions CustomerCreditTransaction[]
  subsidyEntry       PlatformShopSubsidyEntry?

  @@index([salonId, slotStart, slotEnd])
  @@map("bookings")
}

// ---------- FastQue Credits / Wallet V1 ----------
//
// A promotional customer wallet, deliberately NOT built on CustomerLedgerEntry: that model is
// customer DUES (money owed BY the customer for a no-show/late cancellation — see its own doc
// comment), the semantic opposite of a credit balance owed TO the customer. Conflating the two
// would make a single customer row ambiguous about which direction the money moves.
//
// CORRECTED DESIGN (this replaces an earlier version of this comment/model that had two mistakes,
// caught in independent review before any production use): there is no "complete a service and
// automatically earn 20% back" mechanic. Credits only ever enter a wallet through an explicit,
// authorized PROMO_GRANT (platform-admin-only, never self-service) or a RESTORED reversal of a
// redemption whose booking was cancelled. floor(price/50)*10 is a REDEMPTION CAP (the most credit
// a customer may apply against one booking's price), not an earn rate — see
// CustomerCreditsService.computeMaxRedeemable.
//
// Lot-based ledger, not a cached balance counter: there is no `balance` column anywhere. Every
// PROMO_GRANT and RESTORED row is a "lot" carrying its own `remainingAmount` (how much of that
// specific grant is still unspent) and optional `expiresAt`. A customer's spendable balance and
// redemption eligibility are both computed live, at query time, as the sum of remainingAmount
// over lots that are not expired — so an expired grant is mechanically unspendable and simply
// excluded from every read, rather than requiring a sweep job to "deactivate" it, and a cached
// number can never drift from what the ledger actually supports. See
// CustomerCreditsService.getBalance/redeemUpTo for the exact queries.
enum CreditTransactionType {
  // An authorized, auditable grant of promotional credit — see fundingSource/campaignRef/
  // expiresAt below. The ONLY way new spendable value enters a wallet in this product (besides
  // RESTORED). Never self-service — see AdminCreditsController's PLATFORM_ADMIN-only route.
  PROMO_GRANT
  // Applied against a booking's price at creation time, reducing what the customer pays online.
  // Drawn from one or more still-valid PROMO_GRANT/RESTORED lots (soonest-expiring first).
  REDEEMED
  // A REDEEMED amount returned to the customer because the booking that redeemed it was cancelled
  // before the service happened. Deliberately minted as a brand-new, never-expiring lot rather
  // than crediited back to whichever original lot(s) funded the redemption — a customer should
  // never lose restored money to an expiry clock that kept ticking while it was tied up in a
  // booking through no fault of theirs.
  RESTORED
  // Reserved for a future admin correction tool — never written by any code in this phase, and
  // never a substitute for PROMO_GRANT as the normal promotional-credit mechanism.
  MANUAL_ADJUSTMENT
}

// FastQue subsidizes redeemed credits it funded itself; a future SHOP_FUNDED grant (a shop
// funding its own promotion) would mean the shop simply receives less, and FastQue owes it
// nothing for that portion — see PlatformShopSubsidyEntry and
// CustomerCreditsService.redeemUpTo's fundingSource-aware subsidy computation. Only
// FASTQUE_FUNDED is ever actually produced by any code in this phase; SHOP_FUNDED exists so that
// future capability doesn't require a schema change.
enum CreditFundingSource {
  FASTQUE_FUNDED
  SHOP_FUNDED
}

// The anchor row a customer's credit transactions hang off; carries no balance of its own (see
// the lot-based design note above) — it exists so CustomerCreditTransaction has a stable,
// per-customer id to key off, and so a customer with zero credit history still has an
// unambiguous "no rows yet" (not "row with balance 0") represented state.
model CustomerCreditAccount {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CustomerCreditTransaction[]

  @@map("customer_credit_accounts")
}

// Append-only — nothing in CustomerCreditsService ever deletes a row here. The one field that DOES
// get updated in place after creation is `remainingAmount` on a PROMO_GRANT/RESTORED lot, as
// later REDEEMED transactions consume from it — the row itself, and every other field, never
// changes once written, so the full history of what happened is always reconstructable.
model CustomerCreditTransaction {
  id              String                @id @default(uuid())
  accountId       String
  account         CustomerCreditAccount @relation(fields: [accountId], references: [id])
  type            CreditTransactionType
  // Always positive; `type` alone says direction (PROMO_GRANT/RESTORED add, REDEEMED subtracts) —
  // never a signed value, so a display bug can't silently flip a debit into a credit.
  amount          Decimal               @db.Decimal(10, 2)
  // Meaningful only for PROMO_GRANT and RESTORED rows (the "lots" — see the model-group doc
  // comment above): how much of this specific grant/restoration has not yet been consumed by a
  // later REDEEMED transaction. Null for REDEEMED/MANUAL_ADJUSTMENT rows, which never themselves
  // hold spendable balance. Decrements as redemptions draw from this lot; never goes negative
  // (every consuming update is guarded — see CustomerCreditsService.consumeLots).
  remainingAmount Decimal?              @db.Decimal(10, 2)
  bookingId       String?
  booking         Booking?              @relation(fields: [bookingId], references: [id])
  // Free-text/opaque reference to whatever campaign or promotion authorized a PROMO_GRANT — this
  // product does not (yet) have a real Campaign table, so this is intentionally not a foreign key.
  campaignRef     String?
  fundingSource   CreditFundingSource?
  // Only ever set on a PROMO_GRANT lot; null means "never expires". See the model-group doc
  // comment above for how expiry is actually enforced (live query filter, not a sweep).
  expiresAt       DateTime?
  // Required and unique for a PROMO_GRANT (the admin-facing grant endpoint always supplies the
  // same value it required as the request's Idempotency-Key header, so the two can never drift) —
  // a second grant attempt with the same key is a retried request, not a second grant. Null for
  // every other transaction type, whose own idempotency is structurally guaranteed elsewhere (a
  // booking can only be created/cancelled once per real attempt — see BookingsController's
  // existing @Idempotent() interceptor and the booking status state machine).
  idempotencyKey  String?               @unique
  // Why this transaction happened — required for PROMO_GRANT (an admin must always say why),
  // optional elsewhere.
  reason          String?
  note            String?
  createdAt       DateTime              @default(now())

  @@index([accountId, createdAt])
  @@index([bookingId])
  @@map("customer_credit_transactions")
}

enum SubsidyLedgerStatus {
  OUTSTANDING
  SETTLED
  // The booking that created this entry was cancelled before the service happened — FastQue never
  // actually owed the shop this amount, so the entry is voided rather than deleted (an auditable
  // "this was reversed," not silence).
  VOIDED
}

// FastQue subsidizes redeemed credits, not the shop — a shop is always paid its full listed
// price for a completed service. When a customer redeems credits against a booking, this is the
// auditable record of what FastQue owes that shop to make up the difference. One row per booking
// that redeemed credits (never aggregated across bookings), so each is independently traceable
// back to the exact redemption that created it.
model PlatformShopSubsidyEntry {
  id        String              @id @default(uuid())
  salonId   String
  salon     Salon               @relation(fields: [salonId], references: [id])
  bookingId String              @unique
  booking   Booking             @relation(fields: [bookingId], references: [id])
  amount    Decimal             @db.Decimal(10, 2)
  status    SubsidyLedgerStatus @default(OUTSTANDING)
  createdAt DateTime            @default(now())
  voidedAt  DateTime?
  settledAt DateTime?

  @@index([salonId, status])
  @@map("platform_shop_subsidy_entries")
}

model QueueEntry {
  id          String           @id @default(uuid())
  salonId     String
  salon       Salon            @relation(fields: [salonId], references: [id])
  bookingId   String?
  booking     Booking?         @relation(fields: [bookingId], references: [id])
  customerId  String?
  customer    User?            @relation(fields: [customerId], references: [id])
  // Not listed explicitly in DATABASE.md's original field list — added because API.md's walk-in
  // join endpoint accepts an optional serviceId with no other field to hold it before a
  // ServiceSession exists. Documented back into DATABASE.md as a Phase 1 addition, not a
  // contradiction of it. Nullable: an appointment-sourced entry can resolve its service via the
  // linked Booking instead.
  serviceId   String?
  service     Service?         @relation(fields: [serviceId], references: [id])
  source      QueueEntrySource
  tokenNumber Int
  status      QueueEntryStatus @default(WAITING)

  assignedStaffId String?
  assignedStaff   SalonStaff? @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  assignedChairId String?
  assignedChair   Chair?      @relation("AssignedChair", fields: [assignedChairId], references: [id])

  joinedAt             DateTime  @default(now())
  calledAt             DateTime?
  serviceStartedAt     DateTime?
  serviceCompletedAt   DateTime?
  estimatedWaitMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceSessions ServiceSession[]

  @@map("queue_entries")
}

// The concurrency-critical model. See the two partial unique indexes noted at the top of this
// file and enforced in the SQL migration — Prisma schema DSL cannot express them declaratively.
model ServiceSession {
  id           String               @id @default(uuid())
  queueEntryId String
  queueEntry   QueueEntry           @relation(fields: [queueEntryId], references: [id])
  staffId      String
  staff        SalonStaff           @relation(fields: [staffId], references: [id])
  chairId      String
  chair        Chair                @relation(fields: [chairId], references: [id])
  serviceId    String
  service      Service              @relation(fields: [serviceId], references: [id])
  status       ServiceSessionStatus @default(ACTIVE)
  startedAt    DateTime             @default(now())
  endedAt      DateTime?
  createdAt    DateTime             @default(now())

  @@map("service_sessions")
}

// ---------- Payments ----------

model Payment {
  id                String          @id @default(uuid())
  bookingId         String?
  booking           Booking?        @relation(fields: [bookingId], references: [id])
  type              PaymentType
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String?
  providerPaymentId String?         @unique
  idempotencyKey    String          @unique
  status            PaymentStatus   @default(CREATED)
  webhookVerifiedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  refunds           Refund[]
  ledgerSettlements CustomerLedgerEntry[]

  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id])
  amount           Decimal      @db.Decimal(10, 2)
  reason           String?
  providerRefundId String?
  status           RefundStatus @default(INITIATED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("refunds")
}

model CustomerLedgerEntry {
  id                 String       @id @default(uuid())
  customerId         String
  customer           User         @relation(fields: [customerId], references: [id])
  salonId            String
  salon              Salon        @relation(fields: [salonId], references: [id])
  bookingId          String?
  booking            Booking?     @relation(fields: [bookingId], references: [id])
  amount             Decimal      @db.Decimal(10, 2)
  reason             LedgerReason
  status             LedgerStatus @default(OUTSTANDING)
  settledByPaymentId String?
  settledByPayment   Payment?     @relation(fields: [settledByPaymentId], references: [id])
  createdAt          DateTime     @default(now())
  settledAt          DateTime?

  @@map("customer_ledger_entries")
}

// Generic idempotency guard for mutating endpoints (bookings, queue join, payment init,
// cancellation) and deterministic system-triggered transitions (e.g. the no-show sweep job).
model IdempotencyKey {
  key              String   @id
  endpoint         String
  requestHash      String
  responseSnapshot Json?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@map("idempotency_keys")
}

// ---------- Reviews ----------

model Review {
  id            String   @id @default(uuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id])
  customerId    String
  customer      User     @relation(fields: [customerId], references: [id])
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  rating        Int
  comment       String?
  ownerResponse String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("reviews")
}

// ---------- Verification (Phase 18 — foundation only) ----------
//
// Deliberately NOT identity/KYC verification: no Aadhaar/PAN/passport collection, no third-party
// KYC provider, no automated document verification. "Evidence" is owner-supplied free text plus a
// list of already-hosted https links (same "URL-based, no object storage configured" convention as
// Salon photos and SalonStaff.photoUrl) that a human PLATFORM_ADMIN reviews manually. The public
// badge this unlocks must always read as "profile evidence reviewed by BarberCue," never "identity
// verified" — see VERIFICATION_BADGE_CAPTION in packages/shared/src/constants, the single place
// that wording lives so it can never drift between surfaces.
//
// One row per subject (salonId or staffId, whichever applies — never both), enforced by the two
// @@unique constraints below relying on Postgres's default NULLS DISTINCT behavior: a row with
// salonId set is unique on that value, while any number of PROFESSIONAL-type rows (salonId always
// NULL) coexist freely, and symmetrically for staffId. `status` holds the CURRENT state only —
// "NOT_SUBMITTED" is never stored, it is simply the absence of a row for that subject, the same
// "no row = default" convention used elsewhere in this schema (NotificationPreference,
// StaffWorkingHours). Every transition (submit, start review, approve, reject, resubmit) also
// writes an AuditLog entry, so full history survives even though this row only ever holds the
// latest state — reusing the existing generic audit trail rather than inventing a parallel one.
enum VerificationSubjectType {
  SHOP
  PROFESSIONAL
}

enum VerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model VerificationRequest {
  id            String                  @id @default(uuid())
  subjectType   VerificationSubjectType
  salonId       String?
  salon         Salon?                  @relation(fields: [salonId], references: [id])
  staffId       String?
  staff         SalonStaff?             @relation(fields: [staffId], references: [id])
  status        VerificationStatus      @default(SUBMITTED)
  evidenceNotes String?
  evidenceUrls  String[]

  submittedByUserId String
  submittedBy       User     @relation("VerificationSubmitter", fields: [submittedByUserId], references: [id])
  submittedAt       DateTime @default(now())

  reviewedByAdminId String?
  reviewedByAdmin   User?     @relation("VerificationReviewer", fields: [reviewedByAdminId], references: [id])
  reviewNotes       String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salonId])
  @@unique([staffId])
  @@map("verification_requests")
}

// ---------- Notifications ----------

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  type      String
  payload   Json?
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  // Phase 11 additions — an IN_APP notification is read/unread (null = unread) rather than the
  // PENDING/SENT/FAILED delivery-attempt lifecycle SMS/PUSH/EMAIL rows use; deepLink is a client
  // route (e.g. "owner/bookings/:id") the notification-center UI navigates to on tap, optional
  // since not every notification type has one obvious destination.
  readAt    DateTime?
  deepLink  String?

  @@map("notifications")
}

// ---------- Audit ----------

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

// ---------- Subscription (inactive in V1 — see ARCHITECTURE.md §16) ----------

model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  priceMonthly Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  salons       Salon[]
  entitlements PlanEntitlement[]

  @@map("plans")
}

model Entitlement {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  plans PlanEntitlement[]

  @@map("entitlements")
}

model PlanEntitlement {
  planId         String
  plan           Plan        @relation(fields: [planId], references: [id])
  entitlementKey String
  entitlement    Entitlement @relation(fields: [entitlementKey], references: [key])
  value          String

  @@id([planId, entitlementKey])
  @@map("plan_entitlements")
}

// ---------- Customer Premium plans & AI credits (Premium phase) ----------
// Deliberately NOT the same concept as Plan/Entitlement/PlanEntitlement above, which is salon
// (B2B) subscription billing — inert in V1, unrelated to this. This is a customer-facing (B2C)
// annual plan that grants AI Style Advisor credits. Kept as fully separate models rather than
// extended/renamed from the salon Plan table to avoid conflating two different billing contexts
// (a salon's platform tier vs. a customer's AI-credit allowance) under one schema concept.

enum CustomerSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// Every balance-affecting event on a CustomerSubscription's AI credits, for auditability (never
// contains customer photos, image bytes, or API keys — see AiCreditService).
enum AiCreditTransactionType {
  ALLOCATION
  RESERVATION
  CONSUMPTION
  RELEASE
  MANUAL_ADJUSTMENT
}

// `id` is a stable, human-readable string ("basic" | "pro" | "max"), not a uuid — same convention
// as packages/shared's HAIRSTYLE_CATALOG: a small, fixed, code-referenced catalog, not open-ended
// data. Single authoritative source for price/credits — PremiumPlansService reads this table
// rather than any value being hard-coded elsewhere.
model CustomerPremiumPlan {
  id               String   @id
  name             String
  priceInr         Decimal  @db.Decimal(10, 2)
  aiCreditsPerYear Int
  isPopular        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  subscriptions CustomerSubscription[]

  @@map("customer_premium_plans")
}

// One row per purchased/activated annual period. Credits are scoped to the period they were
// granted in (aiCreditsAllocated is a snapshot taken at activation, immune to later plan-price/
// credit edits) — deliberately no rollover/carry-forward logic into a future period, per the
// explicit "keep this simple and auditable" instruction for this phase.
model CustomerSubscription {
  id          String                     @id @default(uuid())
  userId      String
  user        User                       @relation(fields: [userId], references: [id])
  planId      String
  plan        CustomerPremiumPlan        @relation(fields: [planId], references: [id])
  status      CustomerSubscriptionStatus @default(ACTIVE)
  periodStart DateTime                   @default(now())
  periodEnd   DateTime

  aiCreditsAllocated Int
  // Reserved = credits held for an in-flight generation request (not yet succeeded or failed).
  // Consumed = permanently spent on a successful generation. Available = allocated - reserved -
  // consumed; see AiCreditService.hasAvailableCredit. Both are maintained by AiCreditService only,
  // inside a per-subscription-locked transaction (see bookings.service.ts's advisory-lock
  // pattern) — never written to directly by any controller.
  aiCreditsReserved  Int @default(0)
  aiCreditsConsumed  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditTransactions AiCreditTransaction[]

  @@index([userId, status])
  @@map("customer_subscriptions")
}

model AiCreditTransaction {
  id             String                  @id @default(uuid())
  subscriptionId String
  subscription   CustomerSubscription    @relation(fields: [subscriptionId], references: [id])
  type           AiCreditTransactionType
  amount         Int
  note           String?
  createdAt      DateTime                @default(now())

  @@index([subscriptionId, createdAt])
  @@map("ai_credit_transactions")
}

// Issue #13 Mission L (cross-agent handoff with Codex, Issue #10 comment 5522610801): the minimal
// device-registration half of a real OS push pipeline. One row per installed app instance
// (identified by its Expo push token, not by device hardware id — a reinstall gets a new token
// and a new row). expoPushToken is unique and reassignable: if a different user later logs into
// the same physical device/app-install, PushDeviceService.register() reassigns the SAME token row
// to the new userId rather than leaving a stale registration pointing at the previous account.
model PushDevice {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  expoPushToken String   @unique
  platform      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("push_devices")
}
