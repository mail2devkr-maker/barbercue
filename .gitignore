# EAS build debug artifacts (accidental — dumped by troubleshooting an Android build, not
# generated by any script/tooling this project relies on)
apps/mobile/curl.exe
apps/mobile/build-failed*.json
apps/mobile/build[0-9]*.json
apps/mobile/eas-*.raw
apps/mobile/eas-log.txt

# Accidental nested repo snapshot (contains its own .git/.claude — not part of source control)
/eas-inspect-archive/

# Global-location import inputs/outputs (apps/backend/prisma/import-global-locations.ts) — the
# ~108MB dr5hn source SQL the script reads, and the manual-review report it regenerates on every
# run. Neither is source: the data directory is a large third-party download (obtained manually,
# not by any script in this repo) and the report is disposable output. Never commit either.
apps/backend/prisma/data/
apps/backend/import-global-locations-report.json

# prisma/seed-test-shops.ts's generated output — plaintext credentials for every synthetic
# owner/staff account it creates. Never committed, never printed to logs; see that script's own
# header comment for why (hundreds of production-account passwords must never land in git history
# or CI output).
apps/backend/prisma/.test-shop-credentials.json
